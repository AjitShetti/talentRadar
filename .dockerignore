# Keep the build context small: without this the Docker daemon uploads the
# virtualenv, node_modules and the git history before the first RUN, which on
# a free build tier is most of the build time.

.git
.github
.venv
venv
env

node_modules
frontend

__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage
coverage.xml

# Local configuration and secrets — the image reads its settings from the
# host's environment, never from a baked-in .env.
.env
.env.*
!.env.example

# Design references and docs that never ship in the image
stitch
DESIGN.md
PRODUCT.md

*.log
*.sqlite3
.DS_Store
