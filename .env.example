# ============================================================================
# TalentRadar Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# All settings are loaded via config/settings.py using pydantic-settings.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM / AI Services (Required)
# ----------------------------------------------------------------------------
# Groq API key for LLM parsing and generation
# Get one at: https://console.groq.com
GROQ_API_KEY=

# Tavily API key for job posting search and scraping, and for the sourced
# talent-contact lookup in Company Intel
# Get one at: https://tavily.com
TAVILY_API_KEY=

# Optional. GitHub personal access token used by the Company Intel open-source
# panel. Without it GitHub allows 60 requests/hour per IP, which one browsing
# session can exhaust; a token raises that to 5000/hour. Public read scope only.
GITHUB_TOKEN=

# ----------------------------------------------------------------------------
# PostgreSQL Database (Required)
# ----------------------------------------------------------------------------
# Database connection details
# In Docker: use 'postgres' as the host
# In local dev: use 'localhost'
POSTGRES_USER=talentRadar
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=talentRadar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Hosted Postgres (Neon, Supabase, Railway, Render) gives you one DSN instead
# of the five fields above. Set it and it wins; leave it blank to use them.
# The driver prefix is rewritten per use (asyncpg for the app, psycopg2 for
# Alembic), and libpq-only params like sslmode= are stripped for asyncpg.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Require TLS on the database connection. Every hosted provider needs this;
# a local docker-compose Postgres does not.
POSTGRES_SSL=false

# Connection budget PER PROCESS. The real ceiling is
# (POOL_SIZE + MAX_OVERFLOW) x worker count, and free Postgres tiers cap total
# connections low (Supabase 60, Neon ~100). Raise only with headroom to spare.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ----------------------------------------------------------------------------
# Redis (optional)
# ----------------------------------------------------------------------------
# Nothing requires Redis today — there is no Celery worker in this repo, and
# the rate limiter and SSE task map are in-process. It is here for when you
# scale past one worker, which is when both of those have to move out of
# process. In Docker use 'redis' as the host; locally, 'localhost'.
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# Vector store
# ----------------------------------------------------------------------------
# Where job-description embeddings live:
#
#   pgvector  (default) — rows in the Postgres above, in job_embeddings.
#                         Needs the `vector` extension, which Neon and
#                         Supabase both offer free; migration 010 enables it.
#                         This is the only backend with a free managed host.
#   chroma              — the legacy ChromaDB server. Chroma Cloud has no free
#                         tier and self-hosting it needs a persistent volume,
#                         so this is for existing self-hosted installs only.
#   none                — no vector search. Semantic search falls back to the
#                         relational query and no embedding model is ever
#                         loaded, which is how you fit a 512 MB instance.
VECTOR_BACKEND=pgvector

# Embedding width. all-MiniLM-L6-v2 is 384. Changing this needs a new
# migration — the column is typed vector(N).
EMBEDDING_DIM=384

# Only read when VECTOR_BACKEND=chroma.
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ----------------------------------------------------------------------------
# JWT Authentication (Required)
# ----------------------------------------------------------------------------
# Secret key for signing JWT tokens (minimum 32 characters)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-min-32-chars-secret!!

# JWT algorithm (HS256 recommended for most use cases)
JWT_ALGORITHM=HS256

# Token expiry in minutes (60 = 1 hour)
JWT_EXPIRY_MINUTES=60

# ----------------------------------------------------------------------------
# Google Cloud Storage (Optional - for raw JD blob backup)
# ----------------------------------------------------------------------------
# GCS bucket name for storing raw JD HTML backups
GCS_BUCKET_NAME=talentRadar-raw-jds

# Path to service account JSON file
# Leave empty if running locally or using default credentials
GOOGLE_APPLICATION_CREDENTIALS=

# ----------------------------------------------------------------------------
# Frontend Configuration (Required for Next.js frontend)
# ----------------------------------------------------------------------------
# FastAPI base URL for frontend API calls
# In Docker: use 'http://api:8000'
# In local dev: use 'http://localhost:8000'
NEXT_PUBLIC_API_URL=http://localhost:8000



# ----------------------------------------------------------------------------
# Logging (Optional)
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable JSON structured logging (set to 'true' for production)
JSON_LOGGING=false

# ----------------------------------------------------------------------------
# Rate Limiting (Optional)
# ----------------------------------------------------------------------------
# Maximum requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Requests per client per window for ordinary endpoints, and the much stricter
# budget for /api/auth/login and /api/auth/signup.
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# Number of proxies in front of the API, for rate-limit client identification.
# 0 = direct (use the peer address). Behind a PaaS router (Render, Railway,
# Fly, Cloud Run) set this to 1, otherwise every user shares one bucket keyed
# on the router and the whole deployment starts 429-ing under light load.
# Never set it higher than the number of proxies you actually control.
TRUSTED_PROXY_HOPS=0

# Largest resume/audio upload accepted, in bytes (default 5 MiB).
MAX_RESUME_UPLOAD_BYTES=5242880

# Run the in-process daily job-match scheduler. Set false on every replica but
# one if you ever run more than a single process, so the scan does not run N
# times in parallel against the same rows.
ENABLE_SCHEDULER=true

# ----------------------------------------------------------------------------
# Scraping
# ----------------------------------------------------------------------------
# The Camoufox/Scrapling stealth path (Naukri, Indeed India, Instahyre).
# Off by default for two independent reasons: each call launches a headless
# Firefox, which OOMs a 512 MB instance, and it works by impersonating a
# browser against sites whose terms forbid it — a defensible thing to do for
# a personal project, a different thing on a public service. The remaining
# sources (ATS APIs, LinkedIn guest, foundit, freshersworld) still run, so
# live search loses coverage rather than failing.
# Needs the optional dependencies too: pip install .[stealth]
ENABLE_STEALTH_SCRAPERS=false

# ----------------------------------------------------------------------------
# Resume PDF rendering
# ----------------------------------------------------------------------------
#   auto     (default) — pdflatex when it is installed, otherwise the built-in
#                        PyMuPDF renderer. The Docker image ships without TeX
#                        (it costs over a gigabyte), so this means PyMuPDF.
#   latex              — pdflatex only; fail if it is missing.
#   builtin            — PyMuPDF only, even where TeX exists.
PDF_ENGINE=auto



# ----------------------------------------------------------------------------
# Development / Debug (Optional)
# ----------------------------------------------------------------------------
# Enable FastAPI debug mode (set to 'true' for local dev only)
# Development conveniences. DEBUG=true enables the interactive /docs and
# /redoc pages and the wildcard localhost CORS origin. Both are off in
# production: the docs enumerate every endpoint, and the localhost wildcard
# lets a page on any port of a viewer's own machine call the API with
# credentials. Never set this true on a public deployment.
DEBUG=false

# Enable SQLAlchemy query logging (set to 'true' for debugging)
SQL_ECHO=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
